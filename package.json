{
  "name": "agent-farm-cli",
  "version": "0.1.56",
  "description": "Parallel agent farm CLI with queue/worker/review loops",
  "type": "module",
  "main": "dist/interfaces/cli/index.js",
  "exports": {
    ".": "./dist/interfaces/cli/index.js",
    "./core": "./dist/application/public-api.js",
    "./mcp": "./dist/interfaces/mcp/server.js"
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/application/public-api.d.ts"
      ]
    }
  },
  "bin": {
    "agent-farm": "dist/interfaces/cli/index.js",
    "agent-farm-mcp": "dist/interfaces/mcp/server.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall-rebuild-sqlite.mjs",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-panel-core.mjs",
    "dev": "tsx src/interfaces/cli/index.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:bdd": "vitest run test/bdd",
    "validate:waves": "node scripts/ensure-built.mjs && node scripts/validate-waves.mjs",
    "validate:waves:strict": "node scripts/validate-waves-strict.mjs",
    "validate:waves:strict:examples": "node scripts/validate-waves-strict-examples.mjs",
    "validate:reports": "node scripts/validate-node-reports.mjs",
    "migrate:waves:acceptance": "node scripts/migrate-wave-acceptance.mjs",
    "migrate:waves:prompt-hints": "node scripts/migrate-wave-prompt-hints.mjs",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check && npm run validate:waves && npm run validate:waves:strict:examples && npm run test && npm run test:bdd && npm run build && npm run ci:health:local",
    "commit": "node scripts/commit.mjs",
    "release": "node scripts/release.mjs",
    "push": "node scripts/push.mjs",
    "agent-farm": "node ./dist/interfaces/cli/index.js",
    "agent-farm:dev": "tsx src/interfaces/cli/index.ts",
    "farm:init": "npm run build && node ./dist/interfaces/cli/index.js project init --target-dir . --force --no-interactive --storage sqlite --environments cursor --executor opencode --workers 4",
    "farm:dispatch": "bash scripts/agent-farm-dispatch.sh",
    "farm:dispatch:node": "node scripts/agent-farm-dispatch.mjs",
    "farm:dispatch:ps": "node scripts/agent-farm-dispatch.mjs",
    "farm:dispatch:batch": "bash scripts/agent-farm-dispatch-batch.sh",
    "farm:dispatch:batch:node": "node scripts/agent-farm-dispatch-batch.mjs",
    "farm:recover-wave": "npm run build && node scripts/agent-farm-recover-and-wave.mjs",
    "farm:wave": "npm run build && node scripts/agent-farm-dispatch-batch.mjs",
    "farm:session:wave": "npm run build && node scripts/agent-farm-dispatch-batch.mjs test/fixtures/waves/polish-opencode-session-20260510.json",
    "farm:roadmap:wave": "npm run build && node scripts/agent-farm-dispatch-batch.mjs test/fixtures/waves/roadmap-iter-20260510.json",
    "farm:ux:wave": "npm run build && node scripts/agent-farm-dispatch-batch.mjs test/fixtures/waves/ux-roadmap-20260510.json",
    "farm:meta:self-iter:wave": "npm run build && node scripts/agent-farm-dispatch-batch.mjs test/fixtures/waves/meta-self-iter-20260510.json",
    "farm:opt:wave": "npm run build && node scripts/agent-farm-recover-and-wave.mjs test/fixtures/waves/polish-opt-20260511.json",
    "farm:insights": "node ./dist/interfaces/cli/index.js insights",
    "farm:doctor": "node ./dist/interfaces/cli/index.js doctor",
    "farm:doctor:ci": "node ./dist/interfaces/cli/index.js doctor --ci-exit",
    "farm:self-update": "node ./dist/interfaces/cli/index.js self-update --yes --brief",
    "farm:self-update:check": "node ./dist/interfaces/cli/index.js self-update --check --brief",
    "farm:stuck": "node ./dist/interfaces/cli/index.js stuck list --brief",
    "farm:status:line": "node scripts/farm-status-line.mjs",
    "farm:control-plane": "node ./dist/interfaces/cli/index.js control-plane serve",
    "farm:sidebar:build": "node scripts/copy-panel-core.mjs && npm install --prefix extensions/agent-farm-sidebar && npm run build --prefix extensions/agent-farm-sidebar",
    "farm:sidebar:package": "npm run farm:sidebar:build && npm run package --prefix extensions/agent-farm-sidebar",
    "farm:mcp": "node ./dist/interfaces/mcp/server.js",
    "farm:m1:wave": "npm run build && node scripts/agent-farm-dispatch-batch.mjs .agent-farm/waves/m1-cursor-control-plane.json",
    "farm:m2:wave": "npm run build && node scripts/agent-farm-dispatch-batch.mjs .agent-farm/waves/m2-cursor-sdk-spike.json",
    "farm:m3:wave": "node scripts/ensure-built.mjs && node scripts/agent-farm-dispatch-batch.mjs examples/waves/m3-product-onboarding.json",
    "farm:onboarding:15min": "node scripts/ensure-built.mjs && node scripts/onboarding-15min-check.mjs",
    "farm:cursor-sdk:smoke": "npm run build && node scripts/cursor-sdk-smoke.mjs",
    "ci:health:local": "node scripts/ci-health-local.mjs",
    "health:cron:dispatch": "node scripts/trigger-health-cron-workflow.mjs",
    "farm:dashboard": "node ./dist/interfaces/cli/index.js dashboard",
    "farm:dashboard:opencode": "node ./dist/interfaces/cli/index.js dashboard --opencode-feed",
    "farm:dashboard:opencode:dev": "tsx src/interfaces/cli/index.ts dashboard --opencode-feed"
  },
  "keywords": [
    "agent",
    "queue",
    "cli",
    "parallel"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist",
    "scripts",
    "schemas",
    "docs",
    "examples"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.3",
    "ink": "^5.1.0",
    "react": "^18.3.1"
  },
  "peerDependencies": {
    "@cursor/sdk": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@cursor/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "opencode-ai": "^1.14.39",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
