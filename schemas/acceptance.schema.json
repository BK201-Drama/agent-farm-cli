{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-farm:acceptance-spec",
  "title": "Agent Farm acceptance spec（验收规格）",
  "description": "定义一个 POC 的机器可验证验收项与 demo 验收。与 src/application/acceptance/types.ts 中 AcceptanceSpec 对齐。",
  "type": "object",
  "additionalProperties": false,
  "required": ["poc_id", "code_root", "demo", "items"],
  "properties": {
    "poc_id": { "type": "string", "minLength": 1 },
    "code_root": { "type": "string", "minLength": 1 },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "verify"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "how": { "type": "string" },
        "verify": { "type": "string", "minLength": 1 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "verify": { "type": ["string", "null"], "minLength": 1 },
          "needs_human": { "type": "boolean", "default": false },
          "depends_on": {
            "type": "array",
            "default": [],
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
